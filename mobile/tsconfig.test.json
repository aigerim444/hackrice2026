{
  "//": "Compiles the pure domain layer (no React Native imports) so it can run under plain `node --test`.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "build-test",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src/domain/**/*.ts", "src/data/mock/seed.ts"]
}
