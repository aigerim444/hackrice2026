# Copy to .env.local and fill in. .env.local is gitignored; never commit a key.
#
# Verify your setup with:  npm run gemini:doctor

# Turns on real receipt reading and the grounded coach. Without it the app
# still runs — receipts fall back to a demo parse, the coach to its built-in
# heuristic — so this is optional, just better.
#
# Get one at https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional. Only set this if `npm run gemini:doctor` says the default model id
# has moved on; it prints the ids your key can actually reach.
# EXPO_PUBLIC_GEMINI_MODEL=gemini-3.6-flash

# Optional. Points the app at a real backend instead of the in-memory mock.
# See src/data/http/httpApi.ts for the endpoints a server has to serve.
# EXPO_PUBLIC_API_URL=

# Set to "false" to talk to the real Supabase backend instead of the
# in-memory mock. Needs the two vars below, and a signed-in session — the app
# shows a login screen (magic link or a 6-digit code, no password) until then.
# EXPO_PUBLIC_USE_MOCK=false

# Required when EXPO_PUBLIC_USE_MOCK=false. From the project's
# Settings → API in the Supabase dashboard.
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Turns on spoken narration for Semester Wrapped. Gemini writes the seven
# lines, ElevenLabs speaks them. Without these, Wrapped narrates with the
# device's own voice; without a Gemini key too, it uses a written script.
#
# Key: https://elevenlabs.io/app/settings/api-keys (needs Text to Speech)
# Voice id: https://elevenlabs.io/app/voices — ⋯ menu → Copy voice ID
# Check both with: npm run voice:doctor
EXPO_PUBLIC_ELEVENLABS_API_KEY=
EXPO_PUBLIC_ELEVENLABS_VOICE_ID=

# Optional. Only if voice:doctor says the default model id has moved on.
# EXPO_PUBLIC_ELEVENLABS_MODEL=eleven_flash_v2_5
